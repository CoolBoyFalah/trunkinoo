# ─── MADA Configuration ───────────────────────────────────────────────────────

# Your name (how MADA addresses you)
USER_NAME=Falah

# Your email address
USER_EMAIL=falahalzeyoudi55@gmail.com

# ─── API Keys ─────────────────────────────────────────────────────────────────

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (MADA's voice) — https://elevenlabs.io
ELEVENLABS_API_KEY=...

# ElevenLabs Voice ID — go to elevenlabs.io/voices and copy the ID of your chosen voice
# Recommended: "Adam" (professional male) or "Rachel" (professional female)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Place your downloaded credentials.json in the mada/ folder.
# MADA will open a browser to authenticate on first run and save token.json.

# ─── MADA Behavior ────────────────────────────────────────────────────────────

# How many seconds to record voice input (max)
VOICE_RECORD_SECONDS=30

# Morning briefing time (24h format)
BRIEFING_TIME=08:00

# Evening wrap-up time
WRAPUP_TIME=18:00

# Timezone (e.g. Asia/Dubai, America/New_York, Europe/London)
TIMEZONE=Asia/Dubai
